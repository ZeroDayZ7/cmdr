{
  // (Explorer)
  "files.exclude": {
    "**/go.work.sum": true,
    "**/go.sum": true,
    // "**/go.mod": true,
    "**/.gitattributes": true,
    "**/.github": true,
    // "**/.gitignore": true,
    "**/bin/": true,
    "**/README.md": true,
    "**/LICENSE": true,
    "**/SECURITY.md": true
  },

  // (Search)
  "search.exclude": {
    "**/go.work.sum": true,
    "**/go.sum": true,
    // "**/go.mod": true,
    "**/bin/": true,
    "**/backup/": true,
    "**/README.md": true,
    "**/LICENSE": true,
    "**/SECURITY.md": true,
    "**/.gitattributes": true,
    "**/.gitignore": true
  },
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    },
    "editor.defaultFormatter": "golang.go"
  },
  "go.formatTool": "gofumpt",
  "go.lintTool": "golangci-lint",
  "evenBetterToml.schema.enabled": false,
  "go.lintOnSave": "package",
  "editor.rulers": [120, 150],
  "gopls": {
    "ui.diagnostic.staticcheck": false,
    "ui.navigation.importShortcut": "Definition",
    "formatting.gofumpt": false,
    "build.directoryFilters": [
      "-**/node_modules",
      "-**/.git",
      "-**/dist",
      "-**/bin",
      "-**/tmp",
      "-**/vendor",
      "-**/docker"
    ]
  },
  "go.vetOnSave": "off"
}
