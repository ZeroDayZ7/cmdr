{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build cmdr",
      "type": "shell",
      "command": "go",
      "args": ["build", "-o", "bin/cmdr.exe", "."],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "Install cmdr (Global)",
      "type": "shell",
      "command": "go",
      "args": ["install", "."],
      "group": "build",
      "problemMatcher": ["$go"]
    }
  ]
}
